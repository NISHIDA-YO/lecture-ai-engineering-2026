# このファイルを .env にコピーして、自分の値を入れてください。
#   cp .env.example .env
# .env は .gitignore で除外されています。コミットしないでください。

# Google AI Studio（https://aistudio.google.com/apikey）で、個人のアカウントで発行したキー
GEMINI_API_KEY=your-gemini-api-key-here

# 任意：使うモデルを切り替えたいときだけ有効にする（既定は gemini-3.5-flash-lite）
# AIE_MODEL=gemini-3.5-flash
